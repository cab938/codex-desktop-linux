{
  "name": "@codex-desktop-linux/collaborative-markdown-editor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:web:preview": "vite build",
    "build:web:mcp": "vite build --config vite.mcp.config.ts",
    "build:server": "vite build --config vite.server.config.ts && vite build --config vite.broker.config.ts",
    "build:web": "npm run build:web:preview && npm run build:web:mcp",
    "build:plugin": "npm run build:web:mcp && npm run build:server",
    "build": "npm run build:web && npm run build:server && node ./scripts/lifecycle.mjs build",
    "stage": "npm run build:web && npm run build:server && node ./scripts/lifecycle.mjs stage",
    "typecheck": "tsc -p ./tsconfig.json",
    "test:unit": "vitest run",
    "test:feature": "node --test ./test.js",
    "test:server": "node --test ./server/test/*.test.mjs",
    "test:mcp": "npm run build:plugin && node --test ./mcp/test.mjs ./mcp/*.test.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:feature && npm run test:server && npm run test:mcp",
    "clean": "node ./scripts/lifecycle.mjs clean"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.3",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.6.4",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sanity/diff-match-patch": "3.2.0",
    "katex": "0.16.47",
    "lib0": "0.2.117",
    "y-codemirror.next": "0.3.5",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.20",
    "fast-check": "4.8.0",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.8"
  },
  "overrides": {
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "yjs": "13.6.31"
  }
}
